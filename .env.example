# APP_URL: The URL where this applet is hosted (used for self-referential links and webhook documentation)
APP_URL="http://localhost:3000"

# FIREBASE ADMIN SDK (Server-Side)
# Paste the single-line JSON of your Firebase Service Account key (or set GOOGLE_APPLICATION_CREDENTIALS to its file path)
FIREBASE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPLICATION_CREDENTIALS=""
FIREBASE_STORAGE_BUCKET="famous-campaign-mcbh2.firebasestorage.app"

# BOOTSTRAP ADMIN EMAIL (Optional: automatically recognized as admin during setup)
ADMIN_BOOTSTRAP_EMAIL=""

# RAZORPAY TEST MODE CREDENTIALS (Server-Side & Public Key)
# Obtain from Razorpay Dashboard -> Account & Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ARTWORK UPLOAD LIMITS
MAX_ARTWORK_SIZE_MB="25"
